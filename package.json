{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:provision-roles": "node scripts/provision-database-roles.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "libsodium-wrappers": "0.8.4",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.32.0",
    "eslint-config-next": "16.2.12",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
