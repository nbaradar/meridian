DATABASE_OWNER_URL=postgresql://meridian:meridian@localhost:5432/meridian
DATABASE_URL=postgresql://meridian_app:meridian_app@localhost:5432/meridian
OPS_CONTROL_DATABASE_URL=postgresql://meridian_ops_control:meridian_ops_control@localhost:5432/meridian
READ_WORKER_DATABASE_URL=postgresql://meridian_read_worker:meridian_read_worker@localhost:5432/meridian
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
RAW_PAYLOAD_KEY_ID=local-v1
RAW_PAYLOAD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Keyrings are JSON objects from key ID to independently generated base64 keys.
OPS_CREDENTIAL_CURRENT_KEY_ID=local-credential-v1
OPS_CREDENTIAL_KEYRING={"local-credential-v1":"replace-with-base64-encoded-32-byte-key"}
OPS_IDENTITY_CURRENT_KEY_ID=local-identity-v1
OPS_IDENTITY_KEYRING={"local-identity-v1":"replace-with-base64-encoded-32-byte-key"}
OPS_IDENTITY_DIGEST_CURRENT_KEY_ID=local-digest-v1
OPS_IDENTITY_DIGEST_KEYRING={"local-digest-v1":"replace-with-base64-encoded-32-byte-key"}
# RFC 0005: keyed digests that recognize saved YNAB accounts without storing names.
YNAB_LABEL_DIGEST_CURRENT_KEY_ID=local-ynab-label-v1
YNAB_LABEL_DIGEST_KEYRING={"local-ynab-label-v1":"replace-with-base64-encoded-32-byte-key"}
